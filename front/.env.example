# Copy to .env.local for local dev, and add the same keys in Vercel →
# Project → Settings → Environment Variables. Without a project ID the site
# still builds and renders from the defaults in src/lib/content.ts.

# From sanity.io/manage → your project (the same one ../studio uses).
NEXT_PUBLIC_SANITY_PROJECT_ID=4vlbo27c
NEXT_PUBLIC_SANITY_DATASET=production

# Dev only: 1 = ignore Sanity and render from content.ts. Restart `npm run dev`
# after changing it. Has no effect in a build or on Vercel.
NEXT_PUBLIC_LOCAL_CONTENT=

# Shared secret for the publish webhook (POST /api/revalidate). Any long random
# string; paste the same value into the webhook's "Secret" field on sanity.io.
SANITY_REVALIDATE_SECRET=

# Where the deployed studio lives.
# /admin on the site redirects here.
SANITY_STUDIO_URL=https://oussamasoltani.sanity.studio
