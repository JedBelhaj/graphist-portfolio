{
  "name": "soltani-media-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Admin for the Soltani Media site: Sanity Studio, hosted on sanity.studio",
  "scripts": {
    "dev": "sanity dev",
    "build": "sanity build",
    "deploy": "sanity deploy",
    "seed": "sanity exec scripts/seed.ts --with-user-token",
    "migrate:video-sections": "sanity exec scripts/migrate-video-sections.ts --with-user-token",
    "sync-content": "sanity exec scripts/sync-content.ts --with-user-token",
    "bulk-upload": "sanity exec scripts/bulk-upload.ts --with-user-token",
    "upwork:parse": "sanity exec scripts/upwork/parse.ts --",
    "upwork:import": "sanity exec scripts/upwork/import.ts --",
    "upwork:import:dry": "sanity exec scripts/upwork/import.ts -- --dry-run",
    "typegen": "sanity schemas extract --force && sanity typegen generate",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sanity/orderable-document-list": "^2.0.27",
    "@sanity/ui": "^4.4.5",
    "@sanity/vision": "^6.21.0",
    "lexorank": "^1.0.5",
    "lucide-react": "^1.56.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sanity": "^6.21.0",
    "sanity-plugin-media": "^6.6.0",
    "styled-components": "^6.6.0"
  },
  "devDependencies": {
    "@sanity/client": "^8.14.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "acorn": "^8.19.0",
    "cheerio": "^1.2.0",
    "typescript": "^5.9.3"
  }
}
