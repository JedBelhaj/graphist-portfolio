# Copy to .env and fill in. Same project as NEXT_PUBLIC_SANITY_PROJECT_ID in
# ../front — the ID isn't secret (it ships in the deployed studio), but .env
# stays out of git anyway.
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production

# For "Google Drive link" in the image/file pickers (assetSources/googleDrive.tsx).
# This key ships in the deployed studio, so restrict it in Google Cloud Console:
# API restrictions → Google Drive API only; Application restrictions → Websites
# → https://oussamasoltani.sanity.studio/* and http://localhost:3333/*.
SANITY_STUDIO_GOOGLE_API_KEY=

# For the Upwork import (scripts/upwork). PROJECT_ID and DATASET fall back to
# the two above. The token needs Editor rights: sanity.io/manage → the project
# → API → Tokens → Add API token. It's a secret: keep it in .env only.
SANITY_PROJECT_ID=
SANITY_DATASET=
SANITY_WRITE_TOKEN=
